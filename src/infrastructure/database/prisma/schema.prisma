generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Tenant {
  id            String       @id @unique
  name          String
  created_at    DateTime @default(now())

  MessageContext  MessageContext[]
  MessageContact  MessageContact[]
  MessageDocument  MessageDocument[]
  MessageAudio  MessageAudio[]
  MessageVideo  MessageVideo[]
  MessageImage  MessageImage[]
  MessageText  MessageText[]
  Message  Message[]

  Contact  Contact[]
  Session  Session[]
}

enum MessageType {
  text
  image
  video
  audio
  voice
  document
  sticker
  contact
  reply
  system
}

model Contact {
  id    String @id @default(uuid())
  phone String
  name  String
  url_photo String?
  photo_synced_at DateTime?

  tenant_id                        String
  tenant   Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, phone])
}


model Message {
  id         String     @id @default(uuid())
  chat_id    String
  session_id String
  type       MessageType
  from       String
  from_name  String
  from_me    Boolean  @default(false)
  source     String
  forwarded  Boolean  @default(false)
  is_read    Boolean  @default(false)
  edited     Boolean  @default(false)
  edited_at  DateTime?
  timestamp  DateTime
  created_at DateTime @default(now())

  // relações 1:1
  text     MessageText?
  image    MessageImage?
  video    MessageVideo?
  audio    MessageAudio?
  document MessageDocument?
  context  MessageContext?
  contact  MessageContact?

  tenant_id                        String
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageText {
  id         String @id @default(uuid())
  message_id String @unique
  body       String

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String  
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageImage {
  id         String @id @default(uuid())
  message_id String @unique

  mime_type String
  file_size Int
  sha256    String

  link    String
  width   Int?
  height  Int?
  caption String?

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String  
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageVideo {
  id         String @id @default(uuid())
  message_id String @unique

  mime_type String
  file_size Int
  sha256    String

  width   Int?
  height  Int?
  seconds Int?
  caption String?
  link    String

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String  
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageAudio {
  id         String @id @default(uuid())
  message_id String @unique

  mime_type String
  file_size Int
  sha256    String

  seconds Int?
  link    String

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String  
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageDocument {
  id         String @id @default(uuid())
  message_id String @unique

  mime_type String
  file_size Int
  sha256    String

  filename String
  link     String
  caption String?

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String  
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageContext {
  id         String @id @default(uuid())
  message_id String @unique

  quoted_id     String
  quoted_author String
  quoted_type   String

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model MessageContact {
  id         String @id @default(uuid())
  message_id String @unique

  display_name String
  vcard        String
  phone        String?

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  tenant_id                        String
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}


model MessageEventLog {
  id          String   @id @default(uuid())

  session_id  String
  tenant_id   String

  event_name  String   
  message_id  String?  

  payload     Json     

  status      EventStatus @default(pending)

  error       String?

  created_at  DateTime @default(now())
  processed_at DateTime?
}

enum EventStatus {
  pending
  processed
  failed
}



model Session {
  id          String   @id @default(uuid())
  name        String
  descricao   String?
  qrcode      String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // MULTI TENANT
  tenant_id   String
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
}
